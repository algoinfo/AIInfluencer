# Server-side only — never expose to client
# Copy to .env.local and fill in your values

# fal.ai — Motion Transfer (fal-ai/wan-motion)
FAL_KEY=

# Higgsfield — Object Swap (higgsfield/genjutsu/object-swap/v1.0)
# Format: KEY_ID:KEY_SECRET
HF_CREDENTIALS=
# HF_KEY= # alias accepted by the server (same KEY_ID:KEY_SECRET value)

TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Google OAuth (optional — email/password works without it)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override; defaults to http://localhost:3000/api/auth/google/callback in dev
# GOOGLE_REDIRECT_URI=https://genjutsu.online/api/auth/google/callback
# Local networks that block Google: point at your proxy (Clash/V2Ray etc.)
# HTTPS_PROXY=http://127.0.0.1:7890

# Cloudflare R2 — uploads & outputs under the ges/ directory
# Keys land in: ges/image/ · ges/motion/ · ges/resvideo/
R2_ENDPOINT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=vocalove
# Public read base (bucket Settings → Public URL or custom domain)
# Example: https://pub-xxxxxxxx.r2.dev
NEXT_PUBLIC_R2_PUBLIC_URL=

# Waffo — payments + content-safety scan-prompt (same merchant keys)
# https://docs.waffo.ai/zh/api-reference/endpoints/content-safety/scan-prompt
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=
WAFFO_ENVIRONMENT=test
WAFFO_STORE_ID=STO_5G96iWW2JV1u33vZgqGW0C
# Optional: skip prompt screening locally
# WAFFO_CONTENT_SAFETY_SKIP=1
